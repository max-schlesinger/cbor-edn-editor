{
  "name": "vscode-scitt-preview",
  "icon": "docs/product-logo.png",
  "displayName": "SCITT Preview",
  "description": "CBOR Extended Diagnostic Notation (EDN) for SCITT",
  "version": "0.0.1",
  "publisher": "Transmute",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/transmute-industries/vscode-scitt-preview"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "cbor-tools.cbor",
        "displayName": "CBOR EDN Editor",
        "selector": [
          {
            "filenamePattern": "*.cbor"
          },
          {
            "filenamePattern": "*.edn"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "cbor-tools.Cbor.new",
        "title": "Create new CBOR Document",
        "category": "CBOR"
      },
      {
        "command": "cbor-tools.saveAsEdn",
        "title": "Export as EDN",
        "category": "CBOR",
        "icon": "$(file-code)"
      },
      {
        "command": "cbor-tools.saveAsCbor",
        "title": "Export as CBOR",
        "category": "CBOR",
        "icon": "$(file-binary)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cbor-tools.saveAsEdn",
          "group": "navigation",
          "when": "activeCustomEditorId == 'cbor-tools.cbor' && resourceExtname == .cbor"
        },
        {
          "command": "cbor-tools.saveAsCbor",
          "group": "navigation",
          "when": "activeCustomEditorId == 'cbor-tools.cbor' && resourceExtname == .edn"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "gen": "apg -i src/grammar.bnf -o src/grammar.js",
    "compile": "npm run gen && tsc -p ./ && cp src/grammar.js out/grammar.js",
    "lint": "eslint \"src/**/*.ts\"",
    "watch": "npm run gen && tsc -watch -p ./",
    "build:vsix": "vsce package",
    "test:unit": "jest"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.73.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vscode/vsce": "^2.22.0",
    "apg": "^3.1.2",
    "eslint": "^8.26.0",
    "mocha": "^11.7.5",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@transmute/edn": "^0.0.5",
    "apg-js": "^4.4.0",
    "apg-lib": "^3.1.1",
    "cbor": "^9.0.2",
    "cbor2": "^2.0.1",
    "chevrotain": "^11.1.0",
    "edn-data": "^1.1.2"
  }
}
