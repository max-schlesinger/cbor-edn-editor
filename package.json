{
  "name": "vscode-scitt-preview",
  "icon": "docs/product-logo.png",
  "displayName": "SCITT Preview",
  "description": "CBOR Extended Diagnostic Notation (EDN) for SCITT",
  "version": "0.0.1",
  "publisher": "Transmute",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/transmute-industries/vscode-scitt-preview"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "cbor-tools.cbor",
        "displayName": "CBOR",
        "selector": [
          {
            "filenamePattern": "*.cbor"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "scittPreview.Cbor.new",
        "title": "Create new CBOR Document",
        "category": "CBOR"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "gen": "apg -i src/grammar.bnf -o src/grammar.js",
    "compile": "npm run gen && tsc -p ./ && cp src/grammar.js out/grammar.js",
    "lint": "eslint \"src/**/*.ts\"",
    "watch": "npm run gen && tsc -watch -p ./",
    "build:vsix": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^16.18.34",
    "@types/vscode": "^1.73.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vscode/vsce": "^2.22.0",
    "apg": "^3.1.2",
    "eslint": "^8.26.0",
    "prettier": "^3.6.2",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@transmute/edn": "^0.0.5",
    "apg-js": "^4.4.0",
    "apg-lib": "^3.1.1",
    "cbor": "^9.0.2",
    "edn-data": "^1.1.2"
  }
}
